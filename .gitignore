# Environment & Secret Security (NEVER COMMIT KEYS)
.env
.env.*
*.env
*.env.local
*.key
*.pem
license_private_key*.pem
license_private_key*
*.pfx
*.p12
*.token
cookies.txt
*cookie*.txt

# Licensing note: the Ed25519 PRIVATE signing key must never be committed
# (license_private_key*.pem above). The matching PUBLIC key is intentionally
# committable and is NOT ignored: engine/license_public_key.txt

